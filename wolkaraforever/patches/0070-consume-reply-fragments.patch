+static void test_fragment_boundaries(void) {
+    uint8_t storage[8];
+    DWParser parser;
+    dw_init(&parser, storage, sizeof storage);
+    size_t used = 99;
+    assert(dw_feed_fragment(&parser, NULL, 0, &used) == DW_MORE && used == 0);
+    const uint8_t start[] = "+$AB#8";
+    assert(dw_feed_fragment(&parser, start, sizeof start - 1, &used) == DW_ACK && used == 1);
+    assert(dw_feed_fragment(&parser, start + 1, sizeof start - 2, &used) == DW_MORE && used == 5);
+    const uint8_t end[] = "3-$A#00+";
+    assert(dw_feed_fragment(&parser, end, sizeof end - 1, &used) == DW_PACKET && used == 1);
+    assert(parser.length == 2 && memcmp(storage, "AB", 2) == 0);
+    assert(dw_feed_fragment(&parser, end + 1, sizeof end - 2, &used) == DW_NACK && used == 1);
+    assert(dw_feed_fragment(&parser, end + 2, sizeof end - 3, &used) == DW_BAD_CHECKSUM && used == 5);
+    assert(dw_feed_fragment(&parser, end + 7, 1, &used) == DW_ACK && used == 1);
+}
