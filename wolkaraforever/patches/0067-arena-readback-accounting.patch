+    // The complete encoding of zero bytes contains only ASCII '0'. On the
+    // uncommon failure path distinguish malformed hex from valid nonzero data.
+    static func allZeros(_ text: String, count: Int) throws -> Bool {
+        guard count >= 0, count <= capacity / 2, text.utf8.count == count * 2 else {
+            throw PairingError.malformed
+        }
+        if text.utf8.allSatisfy({ $0 == 48 }) { return true }
+        _ = try unhex(text, count: count)
+        return false
+    }
     static func number(_ text: String?) throws -> UInt64 {
         guard let text, !text.isEmpty, text.utf8.count <= 16,
