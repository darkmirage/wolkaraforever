+// Opt-in (--capture-final-pages, Developer service only): the guest's __TEXT
+// exactly as its unpacking initializer left it, which is what
+// tools/build_signed_container.py --capture turns into a Local signing page
+// container on the Mac. It stays in this app's Documents and only its size is
+// logged. Startup continues whether or not the write succeeds.
+static void capture_final_pages(void) {
+    NSString *directory=[NSHomeDirectory() stringByAppendingPathComponent:@"Documents/LocalSigning"];
+    [NSFileManager.defaultManager createDirectoryAtPath:directory withIntermediateDirectories:YES attributes:nil error:nil];
+    char error[256]="";
+    uint64_t written=0;
+    if (si_write_capture(&guest.image,guest.arena.executable,[directory stringByAppendingPathComponent:@"capture.bin"].fileSystemRepresentation,
+                         &written,error,sizeof error))
+        LOG("[signed-image] capture: wrote %llu bytes of final __TEXT to Documents/LocalSigning/capture.bin\n",(unsigned long long)written);
+    else LOG("[signed-image] capture failed: %s\n",error);
 }
 // dlopen the signed container (dyld validates its CodeDirectory and maps its
 // pages), check its layout and bind it to this guest before anything is
@@ -2034,6 +2049,7 @@
