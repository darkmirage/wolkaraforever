             ((void (*)(int,const char **,const char **,const char **))initializer)(argc,argv,env,apple);
             LOG("[native] first original initializer returned\n");
+            if (!signed_image.active && [NSProcessInfo.processInfo.arguments containsObject:@"--capture-final-pages"]) capture_final_pages();
             startup_count(1);
         }
