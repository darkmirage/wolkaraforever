+// Consume at most size bytes, stopping at the first event. consumed is the
+// number of bytes read, including the event byte; zero for an empty fragment.
+DWEvent dw_feed_fragment(DWParser *parser, const uint8_t *bytes, size_t size, size_t *consumed);
 // All-or-nothing packet encoding; returns 0 if the destination is too small.
 size_t dw_encode(const void *payload,size_t length,void *destination,size_t capacity);
