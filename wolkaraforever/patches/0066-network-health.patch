# WolkaraForever layer patch 0066 - opt-in, bounded anonymous TCP health counters
#
# Why: connection reports need enough evidence to distinguish a stalled TCP connection from a healthy one without collecting an endpoint, DNS name, port, payload, account data, or game memory. Game Settings Manager arms this only for the next launch; the runtime owns the bound.
#
# Applies after: 0065-audio-answer-the-hal-from-a-model.patch
# Applies to: runtime/NativeGuest.h, runtime/NativeGuest.m
# Upstream: product-layer diagnostic; off by default.

diff --git a/runtime/NativeGuest.h b/runtime/NativeGuest.h
index ed411e0..fb28380 100644
--- a/runtime/NativeGuest.h
+++ b/runtime/NativeGuest.h
@@ -18,6 +18,9 @@ NGStartupStep ng_startup_step(void);
 // Profile identity for restricted, opt-in runtime experiments.
 void ng_set_profile_identifier(const char *identifier);
 void ng_set_arguments(const char *const *arguments, size_t count);
+// Enable bounded anonymous TCP health counters for this launch. The host consumes its
+// one-launch preference before this call; default: disabled.
+void ng_set_network_health(bool enabled);
 // Host-only cleanup before a guest exits; never reads application memory.
 // Install before guest entry. A nonzero exit remains an error exit.
 typedef void (*NGExitObserver)(int code, void *context);
diff --git a/runtime/NativeGuest.m b/runtime/NativeGuest.m
index 0f90c27..0de98be 100644
--- a/runtime/NativeGuest.m
+++ b/runtime/NativeGuest.m
@@ -28,6 +28,7 @@ static NativeCodeMemory local_quarantine;
 #include "GuestWaitTrace.h"
 #include "ProcessEnd.h"
 #include "SignedImage.h"
+#include "NetworkHealth.h"
 #include <dlfcn.h>
 #include <execinfo.h>
 #include <mach-o/loader.h>
@@ -468,6 +469,8 @@ void ng_set_arguments(const char *const *arguments, size_t count) {
         launch_arguments[launch_argument_count++]=strdup(arguments[i]);
     }
 }
+static bool network_health;
+void ng_set_network_health(bool enabled) { network_health=enabled; }
 // Libraries a profile names beside the executable's own list; see ng_set_libraries.
 static char *launch_root, *launch_libraries[GL_MAX_LIBRARIES];
 static size_t launch_library_count;
@@ -895,6 +898,7 @@ static bool case_insensitive_files;
 static DIR *guest_opendir(const char *);
 static struct dirent *guest_readdir(DIR *);
 static int guest_socket(int, int, int);
+static int guest_close(int);
 static int guest_connect(int, const struct sockaddr *, socklen_t);
 static int guest_getsockopt(int, int, int, void *, socklen_t *);
 static int guest_setsockopt(int, int, int, const void *, socklen_t);
@@ -1051,8 +1055,10 @@ static void *hook(const char *name) {
         HOOK("realpath",guest_realpath); HOOK("realpath$DARWIN_EXTSN",guest_realpath_extsn);
         if (trace_guest) HOOK("readdir",guest_readdir);
     }
+    if (trace_guest || network_health) HOOK("socket",guest_socket);
+    if (network_health) HOOK("close",guest_close);
     if (trace_guest) { HOOK("mkdir",guest_mkdir); HOOK("getenv",guest_getenv);
-        HOOK("socket",guest_socket); HOOK("connect",guest_connect);
+        HOOK("connect",guest_connect);
         HOOK("getsockopt",guest_getsockopt); HOOK("setsockopt",guest_setsockopt);
         HOOK("shutdown",guest_shutdown); HOOK("poll",guest_poll);
         HOOK("sendto",guest_sendto); HOOK("recvfrom",guest_recvfrom);
@@ -1472,7 +1478,7 @@ static unsigned trace_tid(void);
 // Sockets, under --trace-guest: who the guest tries to talk to (a Galaxy
 // client's local socket, an HTTPS endpoint) says what a failed sign-in needed.
 static int guest_socket(int domain, int type, int protocol) {
-    int fd=socket(domain,type,protocol);
+    int fd=network_health ? nh_socket(domain,type,protocol) : socket(domain,type,protocol);
     int code=errno;
     if (trace_guest) {
         const char *family=domain==AF_UNIX?"AF_UNIX":domain==AF_INET?"AF_INET":domain==AF_INET6?"AF_INET6":"?";
@@ -1480,6 +1486,7 @@ static int guest_socket(int domain, int type, int protocol) {
     }
     return fd;
 }
+static int guest_close(int fd) { return network_health ? nh_close(fd) : close(fd); }
 static int guest_connect(int fd, const struct sockaddr *address, socklen_t size) {
     int result=connect(fd,address,size);
     int code=errno;
@@ -2286,6 +2293,10 @@ bool ng_initialize(const char *path, const char *frameworks, const char *library
     }
     trace_guest=[NSProcessInfo.processInfo.arguments containsObject:@"--trace-guest"];
     if (trace_guest) LOG("[native] tracing failed file access, created directories, getenv, sockets and the calls dlsym hands out (--trace-guest)\n");
+    if (network_health) {
+        nh_start(log,15*60);
+        LOG("[native] network health: anonymous TCP counters, max 900 seconds\n");
+    }
     if (trace_guest) {
         struct sigaction crash_registers={0};
         crash_registers.sa_sigaction=guest_crash_registers;
@@ -2615,6 +2626,8 @@ bool ng_initialize(const char *path, const char *frameworks, const char *library
     }
 done:
     LOG("[native] result %s=%s\n",full_startup?"startup_return":"first_initializer",ok?"PASS":"FAIL");
+    nh_stop();
+    network_health=false;
     // Retain live mappings and library handles: initializer-created pointers and
     // worker threads may outlive this call. Only one guest per app process.
     host_debugger_guest_complete(ok);
