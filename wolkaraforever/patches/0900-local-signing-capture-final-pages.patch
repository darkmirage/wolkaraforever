+static const GISegment *guest_text(const GuestImage *guest) {
     const GISegment *text = NULL;
     size_t executable = 0;
     for (size_t i = 0; i < guest->segment_count; i++) {
@@ -92,8 +95,12 @@
         if (!strncmp(s->name, "__TEXT", 16)) text = s;
     }
     if (executable != 1 || !text || !text->size || text->address != guest->header_address ||
-        text->address % GM_PAGE_SIZE || text->size % GM_PAGE_SIZE)
-        BAD("Local signing supports guests whose only executable segment is __TEXT");
+        text->address % GM_PAGE_SIZE || text->size % GM_PAGE_SIZE) return NULL;
+    return text;
+}
+bool si_match_guest(const SIImage *image, const GuestImage *guest, char *error, size_t error_size) {
+    const GISegment *text = guest_text(guest);
+    if (!text) BAD("Local signing supports guests whose only executable segment is __TEXT");
     if (image->size != text->size)
         BAD("container image is %#llx bytes but the guest __TEXT is %#llx bytes; it was built for a different executable",
             (unsigned long long)image->size, (unsigned long long)text->size);
@@ -128,6 +135,31 @@
     *shadow_size = shadow;
     return true;
 }
+bool si_write_capture(const GuestImage *guest, const void *text_bytes, const char *path, uint64_t *written,
+                      char *error, size_t error_size) {
+    const GISegment *text = guest_text(guest);
+    if (!text) BAD("Local signing supports guests whose only executable segment is __TEXT");
+    if (!text_bytes || !path) BAD("no capture source or destination");
+    char partial[1024];
+    if (snprintf(partial, sizeof partial, "%s.partial", path) >= (int)sizeof partial) BAD("capture path is too long");
+    // Written beside the destination and renamed, so an interrupted launch never
+    // leaves a short file the container builder would take for a capture.
+    int fd = open(partial, O_WRONLY | O_CREAT | O_TRUNC | O_NOFOLLOW | O_CLOEXEC, 0600);
+    if (fd < 0) BAD("capture open failed errno=%d", errno);
+    const unsigned char *bytes = text_bytes;
+    uint64_t done = 0;
+    while (done < text->size) {
+        uint64_t left = text->size - done;
+        ssize_t n = write(fd, bytes + done, left > (1u << 24) ? (1u << 24) : (size_t)left);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) { int saved = errno; close(fd); unlink(partial); BAD("capture write failed errno=%d", saved); }
+        done += (uint64_t)n;
+    }
+    if (fsync(fd) || close(fd)) { int saved = errno; unlink(partial); BAD("capture flush failed errno=%d", saved); }
+    if (rename(partial, path)) { int saved = errno; unlink(partial); BAD("capture rename failed errno=%d", saved); }
+    if (written) *written = done;
+    return true;
+}
