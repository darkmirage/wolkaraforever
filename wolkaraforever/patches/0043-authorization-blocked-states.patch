# WolkaraForever layer patch 0043 - authorization: name every blocked state
#
# Why: when the developer service could not prepare a launch, the helper either
# replied nothing at all or with free text, so the app could only say "provider
# status unavailable" for a device that was simply not enrolled. Each refusal now
# carries a state the launch UI can turn into one actionable sentence, and a
# missing device identifier is a reply rather than silence. No new permission,
# fallback or weaker check is introduced: every path still refuses.
# Needs: authorization/App/AuthorizationBlockedState.{h,m} from the layer.
# Applies to: authorization/Tunnel/PacketServiceProbe.swift,
#             authorization/Tunnel/LocalPacketProvider.m,
#             authorization/App/LocalAuthorization.{h,m}
# Upstream: candidate (not submitted).
#
diff --git a/authorization/App/LocalAuthorization.h b/authorization/App/LocalAuthorization.h
index e9ad22a..183fad3 100644
--- a/authorization/App/LocalAuthorization.h
+++ b/authorization/App/LocalAuthorization.h
@@ -11,6 +11,9 @@ FOUNDATION_EXPORT NSNotificationName const TKLocalServiceWaiting;
 
 @interface TKLocalAuthorization : NSObject
 @property(nonatomic,readonly) BOOL localSessionReady;
+// Why the last attempt refused, in the layer's blocked-state vocabulary, or nil
+// when it was not a refusal. A ready session never carries a reason.
+@property(nonatomic,readonly,copy) NSString *localSessionBlockedState;
 // Direct reachability only, no pairing/credentials/debugging. A TCP connection
 // alone does not authenticate the service or grant execution permission.
 + (void)probeDirectAccess:(void (^)(NSString *))completion;
