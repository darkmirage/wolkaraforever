     func receive(_ bytes: Data, now: TimeInterval) -> [Event] {
         guard !terminal, phase != .idle else { return [] }
+        // Measure complete deliveries that start in the full-region read phase.
+        // The gap includes transport and scheduling on the helper's queue.
+        let measuring = phase == .preflight
+        let start = measuring ? ProcessInfo.processInfo.systemUptime : 0
+        defer {
+            if measuring {
+                let end = ProcessInfo.processInfo.systemUptime
+                if let previous = preflightCallbackEnd { preflightBetweenCallbacks += start - previous }
+                preflightHandling += end - start
+                preflightCallbacks += 1
+                preflightCallbackEnd = phase == .preflight ? end : nil
+            } else if phase == .preflight {
+                preflightCallbackEnd = ProcessInfo.processInfo.systemUptime
+            }
+        }
         // Replies answer only commands sent before this call returns: what it
         // emits has not reached the server, so it cannot be answered yet.
         var events: [Event] = [], answerable = outstanding
