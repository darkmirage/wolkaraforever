+static void test_capture(void) {
+    static unsigned char original[TEXT], final[TEXT], back[TEXT + 1];
+    final_pages(final);
+    memcpy(original, final, PAGE);
+    guest_create(original, NULL, PAGE);
+    char dir[] = "/tmp/signed-image-capture.XXXXXX", path[256], partial[300];
+    CHECK(mkdtemp(dir));
+    snprintf(path, sizeof path, "%s/capture.bin", dir);
+    snprintf(partial, sizeof partial, "%s.partial", path);
+    uint64_t written = 0;
+    CHECK(si_write_capture(&guest, final, path, &written, error, sizeof error) && written == TEXT);
+    struct stat st;
+    CHECK(!stat(path, &st) && st.st_size == TEXT && (st.st_mode & 0777) == 0600 && stat(partial, &st));
+    FILE *f = fopen(path, "rb");
+    CHECK(f && fread(back, 1, sizeof back, f) == TEXT);
+    fclose(f);
+    CHECK(!memcmp(back, final, TEXT));
+    // What the container builder makes of the capture binds to the same guest.
+    Container c; SIImage image;
+    container_create(&c, TEXT);
+    memcpy(c.image, back, TEXT);
+    CHECK(locate(&c, &image) && si_match_guest(&image, &guest, error, sizeof error));
+    free(c.bytes);
+    // A guest Local signing cannot run is not captured.
+    guest.segments[1].prot |= 4;
+    unlink(path);
+    EXPECT_ERROR(si_write_capture(&guest, final, path, &written, error, sizeof error), "only executable segment");
+    CHECK(stat(path, &st));
+    guest.segments[1].prot = 3;
+    // A destination that cannot be written leaves nothing behind.
+    char missing[300];
+    snprintf(missing, sizeof missing, "%s/absent/capture.bin", dir);
+    EXPECT_ERROR(si_write_capture(&guest, final, missing, &written, error, sizeof error), "capture open failed");
+    EXPECT_ERROR(si_write_capture(&guest, NULL, path, &written, error, sizeof error), "no capture source");
+    CHECK(stat(path, &st) && stat(partial, &st));
+    CHECK(!rmdir(dir));
+    gm_destroy(&guest.memory);
+}
