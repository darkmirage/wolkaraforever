+DWEvent dw_feed_fragment(DWParser *parser, const uint8_t *bytes, size_t size, size_t *consumed) {
+    for (size_t i = 0; i < size; i++) {
+        DWEvent event = dw_feed(parser, bytes[i]);
+        if (event != DW_MORE) {
+            *consumed = i + 1;
+            return event;
+        }
+    }
+    *consumed = size;
+    return DW_MORE;
+}
